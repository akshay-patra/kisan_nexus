# PostgreSQL database connection URL
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/kisan_nexus
# PostgreSQL database username
SPRING_DATASOURCE_USERNAME=postgres
# PostgreSQL database password (Required)
SPRING_DATASOURCE_PASSWORD=

# Spring Security default user name
SPRING_SECURITY_USER_NAME=kisan_nexus
# Spring Security default user password (Required)
SPRING_SECURITY_USER_PASSWORD=

# Application Server Port
PORT=8080
